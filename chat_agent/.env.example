# Copy to .env. `agentkit dev` sets AGENT_REGISTRY and AGENT_SHARED_TOKEN for you.
NVIDIA_API_KEY=
# NIM_MODEL=moonshotai/kimi-k3

# Fine-grained token with access to prangunj23/ApiAgentService1 (Contents and Pull requests: read and write)
# and prangunj23/ApiAgentService2 (Contents: read and write, which repository_dispatch requires).
GITHUB_TOKEN=

# AGENT_DATA_DIR=~/.apiagent/service1
# UI_ORIGINS=http://localhost:5173
# AUTO_APPROVE_LEARNINGS=false
