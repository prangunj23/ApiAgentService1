# Installed to /etc/apiagent/operation.env by deploy/bootstrap.sh.
# Read by deploy/systemd/operation.service.

# Interface uvicorn binds to. The API has no authentication, so keep it off the
# public internet: bind the Tailscale address, which deploy/set-tailscale-host.sh
# fills in for you. 127.0.0.1 also works if only this VM's agent calls the API.
BIND_HOST=127.0.0.1

PORT=8001
