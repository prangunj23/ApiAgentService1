# Installed to /etc/apiagent/service1-agent.env by deploy/bootstrap.sh (mode 0600).
# Read by deploy/systemd/service1-agent.service. Contains secrets: never commit the filled-in copy.

AGENT_PORT=9001

# Interface the agent binds to. The agent has NO LOGIN, and this VM has a public IP,
# so bind the Tailscale address only. deploy/set-tailscale-host.sh fills this in.
AGENT_HOST=127.0.0.1

# Every Host header the agent accepts, on top of localhost. Requests whose Host is not
# listed get a 403, which is what stops DNS rebinding. Add the name and address that the
# UI and the other agent actually use, including the port.
ALLOWED_HOSTS=apiagent-service1:9001

# Browser origins allowed to make writes. The UI runs on your laptop, not on this VM.
UI_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the agent keeps its database, clones, research, and memory.
AGENT_HOME=/var/lib/apiagent

# Lists every agent and its URL, so the agents can reach each other.
# Copy deploy/registry.example.json to this path and set the real hostnames.
AGENT_REGISTRY=/etc/apiagent/registry.json

# Shared secret for the agent-to-agent routes. Generate once with `openssl rand -base64 32`
# and set the SAME value on every VM, or the agents reject each other with 401.
AGENT_SHARED_TOKEN=

# NVIDIA NIM. Required to chat.
NVIDIA_API_KEY=
NIM_MODEL=moonshotai/kimi-k3

# Fine-grained token: Contents and Pull requests (read and write) on ApiAgentService1,
# and Contents (read and write) on ApiAgentService2, which repository_dispatch requires
# for the notify_service2 tool.
GITHUB_TOKEN=

AUTO_APPROVE_LEARNINGS=false
